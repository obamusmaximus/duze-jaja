[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Unit"
3d_physics/layer_3="Building"
3d_physics/layer_4="Projectile"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"

[shader_globals]

cloud_noise={
"type": "sampler2D",
"value": ""
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_scale={
"type": "float",
"value": 0.0002
}
cloud_coverage={
"type": "float",
"value": 0.45
}
cloud_softness={
"type": "float",
"value": 0.3
}
cloud_shadow_shift={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
