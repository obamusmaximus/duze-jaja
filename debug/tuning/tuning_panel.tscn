text = "TUNING"

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"TuningGapH"

[node name="Tabs" type="TabContainer" parent="Margin/Column/Body"]
