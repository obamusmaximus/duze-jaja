layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Status" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
