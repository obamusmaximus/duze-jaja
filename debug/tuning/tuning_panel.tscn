[gd_scene format=3]

[ext_resource type="Script" path="res://debug/tuning/tuning_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://debug/tuning/tuning_preview.gd" id="2_preview"]
[ext_resource type="Theme" path="res://debug/tuning/tuning_theme.tres" id="3_theme"]

[node name="TuningPanel" type="PanelContainer"]
visible = false
theme = ExtResource("3_theme")
theme_type_variation = &"PanelDeep"
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_type_variation = &"TuningMargin"

[node name="Column" type="VBoxContainer" parent="Margin"]
